{
  "name": "pageshotter",
  "version": "1.5.0",
  "description": "Full-page, visible-area and selection screenshots for Chrome, captured and edited locally.",
  "license": "MIT",
  "homepage": "https://www.pageshotter.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "dev": "node scripts/build.mjs --watch",
    "fixtures": "npx serve tests/fixtures -l 4173",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tabler/icons": "3.49.0",
    "@types/chrome": "0.3.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fflate": "0.8.3",
    "lucide-static": "1.54.0",
    "serve": "14.2.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "konva": "10.7.1"
  }
}
